#!/bin/sh
set -eu

marker=${PI_AUTO_UPGRADE:-0}
printf 'restart=%s args=%s\n' "$marker" "$*" >> /tmp/pi-invocations.log

if [ "${1:-}" = "--version" ]; then
	echo "$PI_TEST_BASE_VERSION"
	exit 0
fi

if [ "$marker" = "1" ]; then
	exec /usr/local/bin/node /app/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js "$@"
fi

exec /usr/local/bin/node /app/runtime/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js "$@"
