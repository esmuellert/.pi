{
  "name": "pi-task-watcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-started asynchronous tasks with foreground status watching",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types -e \"import('./index.ts').then(m => { if (typeof m.default !== 'function') process.exit(1) })\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "typebox": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
