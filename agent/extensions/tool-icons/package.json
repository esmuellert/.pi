{
  "name": "pi-tool-icons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mark pi's tool blocks with a glyph for what ran and how it went",
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "node --experimental-strip-types --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "pi --no-extensions -e . --no-tools --no-session -p 'reply with exactly: SMOKE_OK'"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
