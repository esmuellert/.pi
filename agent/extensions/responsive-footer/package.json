{
	"name": "pi-responsive-footer",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Width-adaptive multi-line footer for the pi coding agent",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "node --experimental-strip-types --test *.test.ts",
		"typecheck": "tsc --noEmit",
		"smoke": "pi --no-extensions -e . --no-tools --no-session -p \"reply with exactly: SMOKE_OK\""
	},
	"dependencies": {
		"pi-codex-study": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@earendil-works/pi-tui": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
