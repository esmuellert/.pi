# Whitelist strategy: ignore everything, then explicitly allow.
# New files (secrets, third-party extensions, caches) default to ignored.
/*
!.gitignore

# --- docs: notes that outlive a session, not loaded into context ---
!/docs/

# --- search routing (lives above agent/) ---
!/web-search.json

# --- agent dir: opt in per file ---
!/agent/
/agent/*
!/agent/settings.json

# --- generated themes: the product of agent/extensions/themes ---
!/agent/themes/
/agent/themes/*
!/agent/themes/*.json
!/agent/themes/*.py

# --- our own extensions only ---
!/agent/extensions/
/agent/extensions/*
# workspace root
!/agent/extensions/package.json
!/agent/extensions/pnpm-workspace.yaml
!/agent/extensions/pnpm-lock.yaml
!/agent/extensions/turbo.json
!/agent/extensions/README.md
!/agent/extensions/tsconfig.json
!/agent/extensions/tsconfig.base.json
!/agent/extensions/scripts/
# our packages
!/agent/extensions/responsive-footer/
!/agent/extensions/cd/
!/agent/extensions/themes/
!/agent/extensions/tool-blocks/
!/agent/extensions/frame-budget/
!/agent/extensions/wheel/

# --- optional, uncomment when created ---
# !/agent/keybindings.json
# !/agent/footer.json
# !/agent/prompts/
# !/agent/skills/

# never: dependencies (68 MB, plus per-package symlink trees) and turbo's cache
/agent/extensions/node_modules/
/agent/extensions/*/node_modules/
/agent/extensions/.turbo/
/agent/extensions/*/.turbo/
